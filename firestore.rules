rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function datosUsuarioActual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esAdmin() {
      return estaAutenticado() && datosUsuarioActual().rol == 'administrador';
    }

    // El super admin es un administrador con el campo `superadmin: true` en su documento de "usuarios"
    // (se marca a mano en Firebase Console). Es el único que puede crear otras cuentas de administrador.
    function esSuperAdmin() {
      return esAdmin() && datosUsuarioActual().get('superadmin', false) == true;
    }

    function esProfesional() {
      return estaAutenticado() && datosUsuarioActual().rol == 'profesional';
    }

    function esPaciente() {
      return estaAutenticado() && datosUsuarioActual().rol == 'paciente';
    }

    function esPropietario(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    // Perfil de cada usuario (paciente, profesional o administrador).
    // Cualquier persona autenticada puede leer perfiles (necesario para
    // mostrar el perfil público del doctor, o el del paciente al doctor).
    //
    // Crear:
    //  - Al registrarse, cada persona solo puede crear SU perfil como paciente (activo) o profesional
    //    (pendiente de revisión): nadie puede autoasignarse rol administrador ni superadmin.
    //  - Un admin da de alta doctores y pacientes.
    //  - Solo el super admin crea cuentas de administrador (y nunca otro super admin: ese campo se
    //    marca a mano en Firebase Console).
    // Actualizar:
    //  - El super admin puede todo, salvo cambiar el campo superadmin.
    //  - Un admin gestiona pacientes y doctores (aprobar, bloquear, reactivar), no a otros administradores.
    //  - Cada persona edita sus propios datos, pero no su rol, estado, superadmin ni los datos de su bloqueo.
    //  - Excepción: cuando su bloqueo temporal ya venció, la propia persona puede reactivar su cuenta
    //    (vuelve al estado que tenía antes del bloqueo).
    // Eliminar: un admin elimina pacientes y doctores; solo el super admin elimina administradores.
    match /usuarios/{uid} {
      allow read: if estaAutenticado();
      allow create: if (
          esPropietario(uid)
          && !('superadmin' in request.resource.data)
          && (
            (request.resource.data.rol == 'paciente' && request.resource.data.estado == 'activo')
            || (request.resource.data.rol == 'profesional' && request.resource.data.estado == 'pendiente')
          )
        )
        || (
          esAdmin()
          && !('superadmin' in request.resource.data)
          && request.resource.data.rol in ['paciente', 'profesional']
        )
        || (esSuperAdmin() && !('superadmin' in request.resource.data) && request.resource.data.rol == 'administrador')
        || (esProfesional() && !('superadmin' in request.resource.data) && request.resource.data.rol == 'paciente');
      allow update: if (
          esSuperAdmin()
          && request.resource.data.get('superadmin', false) == resource.data.get('superadmin', false)
        )
        || (
          esAdmin()
          && resource.data.rol != 'administrador'
          && request.resource.data.rol == resource.data.rol
          && !('superadmin' in request.resource.data)
        )
        || (
          esPropietario(uid)
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.estado == resource.data.estado
          && request.resource.data.get('superadmin', false) == resource.data.get('superadmin', false)
          && request.resource.data.get('bloqueadoHasta', null) == resource.data.get('bloqueadoHasta', null)
          && request.resource.data.get('estadoPrevio', null) == resource.data.get('estadoPrevio', null)
        )
        || (
          esPropietario(uid)
          && resource.data.estado == 'bloqueado_temporal'
          && resource.data.get('bloqueadoHasta', null) != null
          && resource.data.bloqueadoHasta <= request.time
          && request.resource.data.estado == resource.data.get('estadoPrevio', 'activo')
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.get('superadmin', false) == resource.data.get('superadmin', false)
        );
      allow delete: if (esAdmin() && resource.data.rol != 'administrador')
        || (
          esSuperAdmin()
          && resource.data.rol == 'administrador'
          && resource.data.get('superadmin', false) == false
        );
    }

    // Datos profesionales extendidos (especialidad, carnet, disponibilidad, etc.).
    // Un paciente que califica al doctor solo puede tocar su promedio y el total de calificaciones
    // (nada más de su ficha), y el promedio tiene que estar entre 0 y 5.
    match /profesionales/{uid} {
      allow read: if estaAutenticado();
      allow create: if esPropietario(uid) || esAdmin();
      allow update: if esPropietario(uid) || esAdmin() || (
        esPaciente()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['calificacionPromedio', 'totalCalificaciones'])
        && request.resource.data.calificacionPromedio is number
        && request.resource.data.calificacionPromedio >= 0
        && request.resource.data.calificacionPromedio <= 5
        && request.resource.data.totalCalificaciones is int
        && request.resource.data.totalCalificaciones >= 0
      );
      allow delete: if esAdmin();
    }

    // La consulta que el paciente cita como prueba de haber atendido con ese doctor, ya finalizada.
    function consultaFinalizadaValida(pacienteId, doctorId, consultaId) {
      let consulta = get(/databases/$(database)/documents/consultas/$(consultaId)).data;
      return consulta.pacienteId == pacienteId && consulta.doctorId == doctorId && consulta.estado == 'finalizada';
    }

    // Calificaciones de los pacientes a los doctores (1 a 5 estrellas y un comentario opcional).
    // Hay una sola por paciente y doctor: el id del documento es "{doctorId}_{pacienteId}", y cada
    // paciente solo puede crear o cambiar la suya. Solo se puede calificar si ya hubo una consulta
    // finalizada con ese doctor (se referencia su id en "consultaId" y se verifica aquí).
    match /calificaciones/{id} {
      allow read: if estaAutenticado();
      allow create: if esPaciente()
        && request.resource.data.pacienteId == request.auth.uid
        && id == request.resource.data.doctorId + '_' + request.auth.uid
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1
        && request.resource.data.estrellas <= 5
        && request.resource.data.consultaId is string
        && consultaFinalizadaValida(request.auth.uid, request.resource.data.doctorId, request.resource.data.consultaId);
      allow update: if esPaciente()
        && resource.data.pacienteId == request.auth.uid
        && request.resource.data.pacienteId == request.auth.uid
        && request.resource.data.doctorId == resource.data.doctorId
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1
        && request.resource.data.estrellas <= 5
        && request.resource.data.consultaId is string
        && consultaFinalizadaValida(request.auth.uid, resource.data.doctorId, request.resource.data.consultaId);
      allow delete: if esAdmin();
    }

    // Catálogo de especialidades: lo administra solo el equipo de DocTop.
    match /tiposProfesion/{id} {
      allow read: if estaAutenticado();
      allow write: if esAdmin();
    }

    // Denuncias: cualquiera puede crear una a su propio nombre;
    // solo el admin puede leerlas y resolverlas.
    match /reportes/{id} {
      allow create: if estaAutenticado()
        && request.resource.data.denuncianteId == request.auth.uid
        && request.resource.data.denunciadoId is string
        && exists(/databases/$(database)/documents/usuarios/$(request.resource.data.denunciadoId));
      allow read, update, delete: if esAdmin();
    }

    // Apelaciones de usuarios bloqueados: cada usuario puede crear y leer las suyas;
    // solo el admin las resuelve (aceptar = levantar el bloqueo, o rechazar).
    match /apelaciones/{id} {
      allow create: if estaAutenticado() && request.resource.data.usuarioId == request.auth.uid;
      allow read: if esAdmin() || (estaAutenticado() && resource.data.usuarioId == request.auth.uid);
      allow update, delete: if esAdmin();
    }

    // Chat entre paciente y doctor. El id de la conversación es "{pacienteId}_{doctorId}", así que
    // cada participante se reconoce por su uid dentro del id. Los adjuntos (fotos, videos, audios,
    // documentos) se suben a Storage (ver storage.rules) y aquí solo se guarda su URL.
    match /conversaciones/{convId} {
      allow read: if estaAutenticado() && (request.auth.uid in resource.data.participantes || esAdmin());
      allow create: if estaAutenticado()
        && request.auth.uid in convId.split('_')
        && convId == request.resource.data.pacienteId + '_' + request.resource.data.doctorId
        && request.resource.data.participantes.size() == 2;
      allow update: if estaAutenticado()
        && request.auth.uid in resource.data.participantes
        && request.resource.data.participantes == resource.data.participantes;

      match /mensajes/{mensajeId} {
        allow read: if estaAutenticado() && (request.auth.uid in convId.split('_') || esAdmin());
        allow create: if estaAutenticado()
          && request.auth.uid in convId.split('_')
          && request.resource.data.de == request.auth.uid;
      }
    }

    // Informes médicos: los crea y ve solo el doctor que los escribió (no los ve el paciente).
    // Al editar no se puede cambiar de doctor ni de paciente.
    match /informes/{id} {
      allow read: if estaAutenticado() && resource.data.doctorId == request.auth.uid;
      allow create: if esProfesional()
        && request.resource.data.doctorId == request.auth.uid
        && request.resource.data.pacienteId is string;
      allow update: if esProfesional()
        && resource.data.doctorId == request.auth.uid
        && request.resource.data.doctorId == resource.data.doctorId
        && request.resource.data.pacienteId == resource.data.pacienteId;
    }

    // Consultas: el paciente solicita una consulta a un doctor (elige modalidad y ve el costo),
    // sube su comprobante de pago por QR, y un admin valida o rechaza ese comprobante.
    // Solo paciente/doctor involucrados y el admin pueden leerla.
    match /consultas/{id} {
      allow read: if estaAutenticado()
        && (request.auth.uid == resource.data.pacienteId || request.auth.uid == resource.data.doctorId || esAdmin());
      allow create: if esPaciente()
        && request.resource.data.pacienteId == request.auth.uid
        && request.resource.data.doctorId is string
        && request.resource.data.estado == 'pendiente_pago'
        && request.resource.data.modalidad in ['chat', 'llamada', 'video']
        && request.resource.data.costoConsulta is number
        && request.resource.data.fecha is string
        && request.resource.data.hora is string
        && get(/databases/$(database)/documents/profesionales/$(request.resource.data.doctorId)).data.get('suscripcionActiva', false) == true;
      allow update: if estaAutenticado() && (
          (
            request.auth.uid == resource.data.pacienteId
            && request.resource.data.pacienteId == resource.data.pacienteId
            && request.resource.data.doctorId == resource.data.doctorId
            && (
              (resource.data.estado in ['pendiente_pago', 'rechazada'] && request.resource.data.estado == 'pago_en_revision' && request.resource.data.comprobanteUrl is string)
              || (resource.data.estado == 'pendiente_pago' && request.resource.data.estado == 'cancelada')
            )
          )
          || (
            (esAdmin() || request.auth.uid == resource.data.doctorId)
            && resource.data.estado == 'pago_en_revision'
            && request.resource.data.estado in ['habilitada', 'rechazada']
          )
          || (
            (request.auth.uid == resource.data.pacienteId || request.auth.uid == resource.data.doctorId)
            && resource.data.estado == 'habilitada'
            && request.resource.data.estado == 'finalizada'
          )
        );
      allow delete: if esAdmin();
    }

    // Suscripción del doctor a la plataforma (mensual o anual): el doctor paga al admin por QR y
    // sube su comprobante; el admin lo valida. Al aprobar, se activa profesionales/{doctorId}.
    match /suscripciones/{id} {
      allow read: if estaAutenticado() && (request.auth.uid == resource.data.doctorId || esAdmin());
      allow create: if esProfesional()
        && request.resource.data.doctorId == request.auth.uid
        && request.resource.data.estado == 'pendiente_pago'
        && request.resource.data.plan in ['mensual', 'anual']
        && request.resource.data.precio is number;
      allow update: if estaAutenticado() && (
          (
            request.auth.uid == resource.data.doctorId
            && request.resource.data.doctorId == resource.data.doctorId
            && resource.data.estado in ['pendiente_pago', 'rechazada']
            && request.resource.data.estado == 'pago_en_revision'
            && request.resource.data.comprobanteUrl is string
          )
          || (
            esAdmin()
            && resource.data.estado == 'pago_en_revision'
            && request.resource.data.estado in ['activa', 'rechazada']
          )
        );
      allow delete: if esAdmin();
    }

    // Llamadas de audio/video entre paciente y doctor (señalización WebRTC): el id del documento es
    // el mismo que el de su conversación, así que solo hay una llamada vigente por pareja.
    // El contenido técnico (oferta, respuesta, candidatos ICE) lo escriben libremente los dos
    // participantes; lo importante es que nadie ajeno a la conversación pueda leer ni tocar el documento.
    match /llamadas/{convId} {
      allow read: if estaAutenticado() && request.auth.uid in resource.data.participantes;
      allow create: if estaAutenticado()
        && request.auth.uid in convId.split('_')
        && convId == request.resource.data.pacienteId + '_' + request.resource.data.doctorId
        && request.resource.data.participantes.size() == 2
        && request.auth.uid in request.resource.data.participantes;
      allow update: if estaAutenticado() && request.auth.uid in resource.data.participantes;
    }

    // Notificaciones dentro de la app (campanita): cualquier persona autenticada puede crearle una
    // notificación a otra (ej. el doctor avisa de un mensaje, el admin de un pago aprobado), pero solo
    // el destinatario puede leerlas o marcarlas como leídas.
    match /notificaciones/{id} {
      allow read: if estaAutenticado() && resource.data.paraUid == request.auth.uid;
      allow create: if estaAutenticado()
        && request.resource.data.paraUid is string
        && request.resource.data.texto is string
        && request.resource.data.leida == false;
      allow update: if estaAutenticado()
        && resource.data.paraUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      allow delete: if esAdmin();
    }

    // Configuración general (por ahora, el QR y los datos de pago que ve el paciente al pagar
    // una consulta). Cualquiera autenticado la lee; solo el admin la edita.
    match /config/{id} {
      allow read: if estaAutenticado();
      allow write: if esAdmin();
    }

    // Todo lo demás (favoritos,
    // notificaciones: aún no conectadas a la app) queda cerrado salvo
    // para el admin, hasta que se definan sus reglas específicas.
    match /{coleccion}/{id} {
      allow read, write: if esAdmin();
    }
  }
}
